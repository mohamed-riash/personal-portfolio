# Copy to .env.local and fill in only what you need. Every variable is optional;
# leave a value empty to keep that feature disabled.

# Contact form delivery (server-only, never exposed to the browser).
# In development, if neither is set, submissions are saved locally to messages.txt.
# Option 1: Resend API key (recommended on Vercel/serverless)
RESEND_API_KEY=
# Option 2: Gmail SMTP app password (Google Account > Security > App Passwords)
# for the Gmail account given by CONTACT_EMAIL (or site.email).
GMAIL_APP_PASSWORD=

# Recipient address override (defaults to the email in src/lib/site.ts)
CONTACT_EMAIL=

# Public site URL, e.g. https://your-domain.com, used for metadata, sitemap and robots.
# On Vercel the production URL is detected automatically; set this for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Google Analytics measurement ID (G-XXXXXXXXXX). Public by design.
NEXT_PUBLIC_GA_ID=
